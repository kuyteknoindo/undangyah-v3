APP_NAME=Undangyah
# Produksi: APP_ENV=production dan APP_DEBUG=false.
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Produksi: LOG_STACK=daily (rotasi, simpan LOG_DAILY_DAYS hari) dan LOG_LEVEL=warning supaya storage/logs tidak membengkak.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Aplikasi berjalan di PostgreSQL; tes memakai SQLite memori (phpunit.xml).
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=undangyah
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produksi (HTTPS): SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Bila bukan sync, pekerja antrean (php artisan queue:work) wajib jalan: dipakai siaran notifikasi admin (dan backup bila BACKUP_ANTREAN=true).
QUEUE_CONNECTION=database

# Produksi: CACHE_STORE=redis dengan REDIS_DB/REDIS_CACHE_DB dan CACHE_PREFIX/REDIS_PREFIX unik per aplikasi.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@undangyah.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Berkas tujuan kata sandi admin awal (AdminSeeder). Izin 600, jangan di-commit.
ADMIN_LOGIN_FILE=
